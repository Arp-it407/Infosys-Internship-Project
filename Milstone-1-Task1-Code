# Reading Documents & OpenAI Integration:

from langchain_community.document_loaders import (
    TextLoader,
    PyPDFLoader,
    Docx2txtLoader,
    UnstructuredHTMLLoader
)
from langchain_text_splitters import RecursiveCharacterTextSplitter

import os


# Input Files

TXT_FILE = "legal document.txt"
PDF_FILE = "the_constitution_of_india.pdf"
DOCX_FILE = "THE INDIAN PENAL CODE.docx"
HTML_FILE = "India Code_ Section Details.html"


# Output Directory

OUTPUT_DIR = "output"
os.makedirs(OUTPUT_DIR, exist_ok=True)


# Text Splitter Configuration

text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=2000,
    chunk_overlap=200
)


# TXT FILE

print("Processing TXT file...")
txt_docs = TextLoader(TXT_FILE, encoding="utf-8").load()
txt_chunks = text_splitter.split_documents(txt_docs)

with open(f"{OUTPUT_DIR}/txt_chunks.txt", "w", encoding="utf-8") as f:
    for i, chunk in enumerate(txt_chunks, start=1):
        f.write(f"\n------- TXT CHUNK {i} -------\n")
        f.write(chunk.page_content)


# PDF FILE

print("Processing PDF file...")
pdf_docs = PyPDFLoader(PDF_FILE).load()
pdf_chunks = text_splitter.split_documents(pdf_docs)

with open(f"{OUTPUT_DIR}/pdf_chunks.txt", "w", encoding="utf-8") as f:
    for i, chunk in enumerate(pdf_chunks, start=1):
        f.write(f"\n------- PDF CHUNK {i} -------\n")
        f.write(chunk.page_content)


# DOCX FILE

print("Processing DOCX file...")
docx_docs = Docx2txtLoader(DOCX_FILE).load()
docx_chunks = text_splitter.split_documents(docx_docs)

with open(f"{OUTPUT_DIR}/docx_chunks.txt", "w", encoding="utf-8") as f:
    for i, chunk in enumerate(docx_chunks, start=1):
        f.write(f"\n------- DOCX CHUNK {i} -------\n")
        f.write(chunk.page_content)


# HTML FILE

print("Processing HTML file...")
html_docs = UnstructuredHTMLLoader(HTML_FILE).load()
html_chunks = text_splitter.split_documents(html_docs)

with open(f"{OUTPUT_DIR}/html_chunks.txt", "w", encoding="utf-8") as f:
    for i, chunk in enumerate(html_chunks, start=1):
        f.write(f"\n------- HTML CHUNK {i} -------\n")
        f.write(chunk.page_content)

print("Task-1 completed successfully (Milestone-1)")

