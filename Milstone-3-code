import streamlit as st
from sentence_transformers import SentenceTransformer
import chromadb
from PyPDF2 import PdfReader
from docx import Document
# LOGIN CONFIG 
VALID_USERNAME = "Arpit Tiwari"
VALID_PASSWORD = "arpittiwari815"
if "logged_in" not in st.session_state:
    st.session_state.logged_in = False
# LOGIN PAGE
def login_page():
    st.title("🔐 Login")

    username = st.text_input("Username")
    password = st.text_input("Password", type="password")

    if st.button("Login"):
        if username == VALID_USERNAME and password == VALID_PASSWORD:
            st.session_state.logged_in = True
            st.success("Login successful 🎉")
            st.rerun()
        else:
            st.error("Invalid username or password ❌")
#  LOGOUT 
def logout():
    st.session_state.logged_in = False
    st.rerun()
#  DOCUMENT LOADERS 
def load_pdf(file):
    reader = PdfReader(file)
    text = ""
    for page in reader.pages:
        text += page.extract_text()
    return text
def load_docx(file):
    doc = Document(file)
    return "\n".join([p.text for p in doc.paragraphs])
def load_txt(file):
    return file.read().decode("utf-8")
#  VECTOR DB SETUP 
model = SentenceTransformer("all-MiniLM-L6-v2")
client = chromadb.Client()
collection = client.get_or_create_collection("legal_docs")
def add_to_db(text):
    chunks = [text[i:i+500] for i in range(0, len(text), 500)]
    embeddings = model.encode(chunks).tolist()
    for i, chunk in enumerate(chunks):
        collection.add(
            documents=[chunk],
            embeddings=[embeddings[i]],
            ids=[str(i)]
        )
def search_db(query):
    q_embed = model.encode([query]).tolist()
    result = collection.query(query_embeddings=q_embed, n_results=3)
    return " ".join(result["documents"][0])
#  MAIN APP 
def main_app():
    st.title("⚖️ Legal AI Chatbot")

    if st.button("🚪 Logout"):
        logout()

    uploaded_files = st.file_uploader(
        "Upload IPC, Constitution, or Legal Files",
        type=["pdf", "docx", "txt"],
        accept_multiple_files=True
    )

    if uploaded_files:
        for file in uploaded_files:
            if file.name.endswith(".pdf"):
                text = load_pdf(file)
            elif file.name.endswith(".docx"):
                text = load_docx(file)
            else:
                text = load_txt(file)
            add_to_db(text)

        st.success("Documents successfully loaded into AI memory.")

    question = st.text_input("Ask your legal question:")

    if st.button("Ask"):
        if question:
            context = search_db(question)

            st.subheader("Answer:")
            st.write(context)
        else:
            st.warning("Please enter a question.")
#  ROUTING 
if st.session_state.logged_in:
    main_app()
else:
    login_page()
